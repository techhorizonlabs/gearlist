// Gearlist public site. An assets-only Cloudflare Worker: no Worker script.
// Build dist first with `python3 site/build_site.py`, then run `wrangler deploy` from this folder.
// Security headers come from dist/_headers, which the build writes.
// Served on gearlist.build and www.gearlist.build as Worker custom domains.
{
  "name": "gearlist-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "gearlist.build", "custom_domain": true },
    { "pattern": "www.gearlist.build", "custom_domain": true }
  ]
}
