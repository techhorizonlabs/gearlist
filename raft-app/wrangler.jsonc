// Gearlist Raft App. A separate Worker from gearlist-site, meant for https://raft.gearlist.build.
// Build the site first (python3 build.py && python3 site/build_site.py from the repository root).
// build.command then copies the two catalog files into ./catalog, which the Worker reads
// through ASSETS, as site/worker does. run_worker_first keeps every request in the Worker,
// so nothing in ./catalog is served directly.
//
// Registered in Raft on 7 November 2026 as client key "gearlist" and served at
// https://raft.gearlist.build. workers.dev and preview URLs stay off.
//
// Secrets (set with `wrangler secret put`, never in this file):
//   RAFT_CLIENT_SECRET  the client secret Raft shows once after registration
//   SESSION_SECRET      at least 32 random characters, for the session cookie key
{
  "name": "gearlist-raft",
  "main": "./src/index.mjs",
  "account_id": "4357dc09ae3d87062853043304b53fe6",
  "compatibility_date": "2026-11-01",
  "build": { "command": "node scripts/copy-catalog.mjs" },
  "assets": {
    "directory": "./catalog",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://raft.gearlist.build",
    "RAFT_API_ORIGIN": "https://api.raft.build",
    // The client ID Raft gives at registration. Login and every action refuse while it is empty.
    "RAFT_CLIENT_ID": "gearlist"
  },
  // Per-IP budget for the callback and the actions. namespace_id must not be used by
  // another Worker on the account (gearlist-site uses 4271).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4272",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Custom logs only. Invocation logs would record request URLs (the callback carries the
  // one-time code) and request headers (the session cookie).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "raft.gearlist.build", "custom_domain": true }]
}
